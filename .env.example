# Discord webhook URL — Discord channel → Edit Channel → Integrations → Webhooks
# NEVER commit your real value. Keep it only in your local .env or in your
# GitHub repo's Actions secrets.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Which price source to use: "scrape" (default) or "coingecko"
PRICE_SOURCE=scrape

# --- scrape mode (PRICE_SOURCE=scrape) ---
# Only scrape sites whose robots.txt and Terms of Service permit it.
# The product page you want to monitor.
# Example below uses books.toscrape.com, a public sandbox site built
# specifically for scraping practice (no robots.txt restrictions).
PRODUCT_URL=https://books.toscrape.com/catalogue/a-light-in-the-attic_1000/index.html

# CSS selector matching the element that contains the price text.
# Find it in your browser: right-click the price on the page -> Inspect,
# then use the element's class or id (e.g. ".price", "#priceblock_ourprice").
PRICE_SELECTOR=.price_color

# Currency symbol to show in Discord alerts (defaults to "$").
# books.toscrape.com prices are in GBP.
CURRENCY_SYMBOL=£

# --- coingecko mode (PRICE_SOURCE=coingecko) ---
# Uses CoinGecko's free public API (no key needed) for a live, real-time price.
# Find valid coin ids at https://www.coingecko.com (e.g. "bitcoin", "ethereum").
COINGECKO_COIN_ID=bitcoin
COINGECKO_VS_CURRENCY=usd

# Optional: friendly name shown in Discord alerts
# (defaults to PRODUCT_URL in scrape mode, or the coin id in coingecko mode)
PRODUCT_NAME=My Tracked Product

# Optional: HTTP request timeout in seconds (default 15)
REQUEST_TIMEOUT=15
